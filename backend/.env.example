# Silvy's Kitchen — Backend Environment Variables Template
# Set these variables in your hosting provider (Render, Railway, Heroku, AWS, Docker, etc.)

# PostgreSQL Database Configuration (Production)
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-db-host>:5432/<your-db-name>
SPRING_DATASOURCE_USERNAME=<your-db-username>
SPRING_DATASOURCE_PASSWORD=<your-db-password>
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Security & Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<your-secure-admin-password>

# Production CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=https://silvys-kitchen.vercel.app,https://silvys-kitchen-admin.vercel.app

# H2 Console (Disabled in production for security)
SPRING_H2_CONSOLE_ENABLED=false

# WhatsApp Business Number (Default: 917639164647)
WHATSAPP_PHONE_NUMBER=917639164647
